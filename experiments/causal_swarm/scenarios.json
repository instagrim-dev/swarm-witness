          "recipient": "B",
          "grant_id": "g",
          "parents": [
            "e3"
          ]
        },
        {
          "id": "e5",
          "op": "claim",
          "actor": "A",
          "grant_id": "g",
          "task_id": "compile",
          "epoch": "e1",
          "call_id": "a1",
          "parents": [
            "e4"
          ]
        },
        {
          "id": "e6",
          "op": "claim",
          "actor": "B",
          "grant_id": "g",
          "task_id": "compile",
          "epoch": "e1",
